# 橦云学习 · 环境变量示例
# 复制为 .env 后按需填写，切勿提交真实凭据。
#
# 架构与对接说明：
# 1. tongyun-words（原独立仓）已归档，其背单词/练习前端和历史提交已并入本仓根目录（Nuxt 4 + Nitro）。
# 2. 阿学（学习导师 Agent）对接 legacy/ 学习服务，使用 LEARN_TOKEN_AXUE_SHA256 鉴权与操作接口。
#    legacy/ 旧学习服务（FastAPI）的环境变量详见 legacy/.env.example，前缀为 LEARN_。
# 3. 百度翻译已改造为服务端代理（/learn/api/translate），密钥只在服务端读取，绝对不进入前端或静态包。

# 静态站子路径（默认 /learn/）
NUXT_APP_BASE_URL=/learn/

# ---- Nitro / 背单词与用户接口（原 tongyun-words 归档合并进服务端，不进前端构建产物） ----
# MySQL 连接串（用于背单词做题历史 words_attempts 与卡片状态 words_card_state 同步）
WORDS_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tongyun_learn
# 会话签名密钥（随机长字符串，用于用户登录 Session 校验）
WORDS_SESSION_SECRET=
# 只读统计令牌（Bearer Token，用于外部监控只读抓取统计）
WORDS_STATS_TOKEN=
# 看板/统计登录管理账号与口令哈希
WORDS_BOSS_USER=boss
WORDS_BOSS_PASS_HASH=

# ---- Nitro / 百度翻译服务端代理（由服务端安全保管并计算签名，严禁打进前端或静态产物） ----
# 百度翻译开放平台 App ID 与密钥（未配置时接口优雅降级，前端不报错）
# BAIDU_TRANSLATE_APPID=
# BAIDU_TRANSLATE_KEY=
