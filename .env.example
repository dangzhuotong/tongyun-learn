# tongyun-learn 环境变量配置示例
# 计算 Bearer Token 的 SHA256 哈希值方法:
# python3 -c "import secrets,hashlib;t=secrets.token_urlsafe(32);print(t);print(hashlib.sha256(t.encode()).hexdigest())"

# 数据库连接串 (生产环境: mysql+pymysql://USER:PASS@127.0.0.1:3306/tongyun_learn?charset=utf8mb4)
LEARN_DATABASE_URL=sqlite:///./dev.db

# FastAPI 根路径前缀 (uvicorn 也需配 --root-path /learn/api)
LEARN_ROOT_PATH=/learn/api

# CORS 允许源 (逗号分隔列表；留空表示不开启 CORS 中间件)
LEARN_CORS_ORIGINS=

# Bearer Token SHA256 哈希 (十六进制；服务端仅存 SHA256，不存明文 token)
LEARN_TOKEN_WEB_SHA256=
LEARN_TOKEN_AXUE_SHA256=

# 限流配置 (每分钟请求数；单 worker 进程内令牌桶)
LEARN_RATE_WEB_PER_MIN=60
LEARN_RATE_AXUE_PER_MIN=120

# AI 每日调用额度上限 (api_usage 计数，缓存命中不计)
LEARN_AI_DAILY_WEB=200
LEARN_AI_DAILY_AXUE=500

# AI 模型配置 (-openai 结尾走 Chat Completions，其余走 /openai/v1/responses)
LEARN_AI_MODEL=gemini-3-8-flash-openai
LEARN_AI_FALLBACK_MODEL=deepseek-v4-1-flash
LEARN_AI_TIMEOUT_S=30.0
LEARN_AI_TOTAL_BUDGET_S=50.0

# KIE AI 接口与凭据 (KIE_API_KEY 不带 LEARN_ 前缀，repr 及日志中绝不打印)
LEARN_KIE_BASE_URL=https://api.kie.ai
KIE_API_KEY=

# 时区
LEARN_TZ=Asia/Shanghai

# 接口文档 /v1/docs、/v1/openapi.json，生产保持 false
LEARN_DOCS_ENABLED=false
