# 橦云学习 环境变量配置示例（复制为 .env 后按需填写，勿提交真实凭据）

# 部署子路径（默认 /learn/）
NUXT_APP_BASE_URL=/learn/

# 站点与 API 基础配置（前端运行时配置）
API_BASE=http://localhost/
ORIGIN=https://example.com
HOST=localhost
VITE_PASSWORD_RSA_PUBLIC_KEY=your_rsa_public_key_placeholder

# Nitro 服务端与数据库配置（仅在服务端进程中读取，切勿暴露给前端）
WORDS_DATABASE_URL=mysql://user:password@127.0.0.1:3306/tongyun_learn
WORDS_SESSION_SECRET=your_session_secret_placeholder
WORDS_STATS_TOKEN=your_stats_token_placeholder
WORDS_BOSS_USER=boss
WORDS_BOSS_PASS_HASH=your_password_hash_placeholder
