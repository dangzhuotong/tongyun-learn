# 橦云学习 环境变量示例（复制为 .env 后按需填写，勿提交真实值）
# 部署子路径
NUXT_APP_BASE_URL=/learn/
# 百度翻译的 appid/key 不要写进前端环境变量（会打进静态 HTML）。见 docs/TODO.md。

# Nitro 背单词接口（只在服务端进程里读，不要写进前端）
# WORDS_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tongyun_learn
# WORDS_SESSION_SECRET=
# WORDS_STATS_TOKEN=
# WORDS_BOSS_USER=boss
# WORDS_BOSS_PASS_HASH=
