# 橦云学习 · 环境变量示例
# 复制为 .env 后按需填写，切勿提交真实凭据。
# 旧学习服务（legacy/）的环境变量见 legacy/.env.example，前缀为 LEARN_。

# 静态站子路径（默认 /learn/）
NUXT_APP_BASE_URL=/learn/

# ---- Nitro / 背单词接口（只在服务端进程读取，不会打进前端） ----
# MySQL 连接串
WORDS_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tongyun_learn
# 会话签名密钥（随机长字符串）
WORDS_SESSION_SECRET=
# 只读统计令牌（Bearer）
WORDS_STATS_TOKEN=
# 看板/统计登录账号与口令哈希
WORDS_BOSS_USER=boss
WORDS_BOSS_PASS_HASH=

# ---- Nitro / 百度翻译服务端代理（只在服务端进程读取，不会打进前端） ----
# 百度翻译开放平台 App ID 与密钥（见 docs/TODO.md）
# BAIDU_TRANSLATE_APPID=
# BAIDU_TRANSLATE_KEY=
