    {
      "id": "java-0016",
      "point_id": "java.concurrency.basics",
      "level": 2,
      "type": "concept",
      "prompt": "volatile 能保证可见性和有序性，不能保证什么？",
      "answer": "原子性",
      "accept": [
        "atomicity",
        "原子",
        "不保证原子性"
      ],
      "explain": "count++ 是读-改-写三步，volatile 无法让它原子化。需要用 AtomicInteger 或加锁。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0017",
      "point_id": "java.concurrency.basics",
      "level": 1,
      "type": "code",
      "prompt": "敲一行：创建固定 4 个线程的线程池（Executors 写法）",
      "answer": "ExecutorService pool = Executors.newFixedThreadPool(4);",
      "accept": [
        "Executors.newFixedThreadPool(4)",
        "ExecutorService pool=Executors.newFixedThreadPool(4);"
      ],
      "explain": "面试常追问：阿里规范建议用 ThreadPoolExecutor 显式创建。因为 newFixedThreadPool 的队列无界，可能 OOM。",
      "code": "ExecutorService pool = Executors.newFixedThreadPool(4);",
      "tags": [
        "编码",
        "面试"
      ]
    },
    {
      "id": "java-0018",
      "point_id": "java.jvm.memory",
      "level": 1,
      "type": "term",
      "prompt": "new 出来的对象实例主要分配在 JVM 哪块内存？",
      "answer": "堆",
      "accept": [
        "heap",
        "Java堆",
        "堆内存"
      ],
      "explain": "堆是线程共享的，也是 GC 的主要区域。栈存局部变量和栈帧，线程私有。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0019",
      "point_id": "java.jvm.memory",
      "level": 2,
      "type": "term",
      "prompt": "JDK 8 起，用什么取代了永久代存放类元数据？",
      "answer": "元空间",
      "accept": [
        "Metaspace",
        "metaspace",
        "元数据区"
      ],
      "explain": "元空间使用本地内存，不在堆中。可以用 -XX:MaxMetaspaceSize 限制大小。",
      "tags": [
        "面试"
      ]
    },
