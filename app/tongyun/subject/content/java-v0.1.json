    {
      "id": "java-0001",
      "point_id": "java.object.equals-hashcode",
      "level": 1,
      "type": "concept",
      "prompt": "重写 equals 时必须同时重写哪个方法？",
      "answer": "hashCode",
      "accept": [
        "hashcode",
        "hashCode()",
        "哈希码"
      ],
      "explain": "equals 相等的对象 hashCode 必须相等。只重写 equals 会让 HashSet/HashMap 把相等对象放进不同桶。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0002",
      "point_id": "java.object.equals-hashcode",
      "level": 1,
      "type": "term",
      "prompt": "只重写 equals、不重写 hashCode，两个 equals 相等的对象放进 HashSet，通常有几个元素？",
      "answer": "2",
      "accept": [
        "两个",
        "二",
        "2个"
      ],
      "explain": "默认 hashCode 基于对象身份，两者大概率落不同桶，equals 根本没机会比较。所以通常是 2 个。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0003",
      "point_id": "java.object.equals-hashcode",
      "level": 2,
      "type": "code",
      "prompt": "敲一行：用 Objects 工具类为 name 和 age 生成 hashCode",
      "answer": "return Objects.hash(name, age);",
      "accept": [
        "return Objects.hash(name,age);",
        "Objects.hash(name, age)",
        "Objects.hash(name,age)"
      ],
      "explain": "Objects.hash 会对多个字段组合计算哈希，并处理 null。",
      "code": "return Objects.hash(name, age);",
      "tags": [
        "编码"
      ]
    },
    {
      "id": "java-0004",
      "point_id": "java.collections.basics",
      "level": 1,
      "type": "term",
      "prompt": "List、Set、Map 中，哪个不继承 Collection 接口？",
      "answer": "Map",
      "accept": [
        "map",
        "java.util.Map"
      ],
      "explain": "Map 是键值对，独立于 Collection 体系。List 和 Set 都继承 Collection。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0005",
      "point_id": "java.collections.basics",
      "level": 1,
      "type": "concept",
      "prompt": "ArrayList 底层是什么数据结构？",
      "answer": "数组",
      "accept": [
        "动态数组",
        "array",
        "Object[]",
        "可扩容数组"
      ],
      "explain": "ArrayList 基于 Object[]，随机访问 O(1)。容量不足时扩容为约 1.5 倍。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0006",
      "point_id": "java.collections.hashmap",
      "level": 1,
      "type": "term",
      "prompt": "HashMap 默认负载因子是多少？",
      "answer": "0.75",
      "accept": [
        "0.75f",
        ".75",
        "3/4"
      ],
      "explain": "元素数超过 容量×0.75 时扩容。这是时间与空间的折中。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0007",
      "point_id": "java.collections.hashmap",
      "level": 1,
      "type": "term",
      "prompt": "HashMap 默认初始容量是多少？",
      "answer": "16",
      "accept": [
        "1<<4",
        "十六"
      ],
      "explain": "JDK 8 中首次 put 时懒初始化为 16。容量始终是 2 的幂。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0008",
      "point_id": "java.collections.hashmap",
      "level": 2,
      "type": "term",
      "prompt": "JDK 8 HashMap 单个桶链表长度达到多少时考虑树化？",
      "answer": "8",
      "accept": [
        "八",
        "TREEIFY_THRESHOLD=8"
      ],
      "explain": "链表达到 8 且表容量至少 64 时转红黑树，否则先扩容。红黑树节点数降到 6 时退化回链表。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0009",
      "point_id": "java.collections.hashmap",
      "level": 2,
      "type": "term",
      "prompt": "HashMap 树化要求的最小表容量是多少？",
      "answer": "64",
      "accept": [
        "六十四",
        "MIN_TREEIFY_CAPACITY=64"
      ],
      "explain": "表容量小于 64 时，链表过长优先扩容而不是树化。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0010",
      "point_id": "java.collections.hashmap",
      "level": 2,
      "type": "concept",
      "prompt": "HashMap 允许 null 作为 key 吗？允许几个？",
      "answer": "1个",
      "accept": [
        "一个",
        "1",
        "允许一个",
        "可以，一个"
      ],
      "explain": "HashMap 允许一个 null key（放在 0 号桶）和多个 null value。Hashtable 和 ConcurrentHashMap 都不允许 null。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0011",
      "point_id": "java.collections.concurrenthashmap",
      "level": 3,
      "type": "concept",
      "prompt": "JDK 8 的 ConcurrentHashMap 用什么替代了分段锁 Segment？",
      "answer": "CAS+synchronized",
      "accept": [
        "CAS和synchronized",
        "cas + synchronized",
        "synchronized+CAS",
        "CAS 加 synchronized"
      ],
      "explain": "空桶用 CAS 插入，非空桶对头节点加 synchronized。锁粒度降到单个桶。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0012",
      "point_id": "java.lang.string",
      "level": 1,
      "type": "concept",
      "prompt": "String 为什么不可变？最关键的修饰符是哪个？",
      "answer": "final",
      "accept": [
        "final 修饰",
        "private final"
      ],
      "explain": "内部存储数组是 private final，且不对外暴露修改方法。不可变让 String 可以安全缓存 hashCode、放进常量池。",
      "tags": [
        "面试"
      ]
    },
    {
      "id": "java-0013",
      "point_id": "java.lang.string",
      "level": 1,
      "type": "term",
      "prompt": "单线程下拼接大量字符串，推荐用哪个类？",
      "answer": "StringBuilder",
      "accept": [
        "stringbuilder",
        "java.lang.StringBuilder"
      ],
      "explain": "StringBuilder 非线程安全但更快。多线程共享时才用 StringBuffer。",
      "tags": [
        "面试"
      ]
    },
    {
