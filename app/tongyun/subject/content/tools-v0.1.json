    {
      "id": "tool-0001",
      "point_id": "tools.git.basics",
      "level": 1,
      "type": "code",
      "prompt": "新建并切换到分支 feat/start-learn（用 git switch）。",
      "answer": "git switch -c feat/start-learn",
      "explain": "git switch -c 是较新的写法，等价于 git checkout -b。",
      "tags": [
        "效率工具"
      ],
      "accept": [
        "git checkout -b feat/start-learn"
      ],
      "grading": "auto",
      "code": "git switch -c feat/start-learn"
    },
    {
      "id": "tool-0002",
      "point_id": "tools.git.basics",
      "level": 1,
      "type": "code",
      "prompt": "查看工作区和暂存区的状态。",
      "answer": "git status",
      "explain": "提交前先看一眼，避免把不该提交的文件带进去。",
      "tags": [
        "效率工具"
      ],
      "accept": [
        "git status -s"
      ],
      "grading": "auto",
      "code": "git status"
    },
    {
      "id": "tool-0003",
      "point_id": "tools.git.basics",
      "level": 1,
      "type": "code",
      "prompt": "以单行形式查看提交历史，并显示分支图。",
      "answer": "git log --oneline --graph",
      "explain": "看清分支是怎么分叉、怎么合并的。",
      "tags": [
        "效率工具"
      ],
      "accept": [
        "git log --graph --oneline",
        "git log --oneline --graph --all"
      ],
      "grading": "auto",
      "code": "git log --oneline --graph"
    },
    {
      "id": "tool-0004",
      "point_id": "tools.git.basics",
      "level": 1,
      "type": "code",
      "prompt": "把暂存区的文件 a.txt 撤回到未暂存（不改文件内容）。",
      "answer": "git restore --staged a.txt",
      "explain": "只撤销 git add，不改文件内容。",
      "tags": [
        "效率工具"
      ],
      "accept": [
        "git reset a.txt",
        "git reset HEAD a.txt"
      ],
      "grading": "auto",
      "code": "git restore --staged a.txt"
    },
    {
      "id": "tool-0005",
      "point_id": "tools.git.basics",
      "level": 1,
      "type": "choice",
      "prompt": "git merge 和 git rebase 的主要区别？",
      "answer": "merge 保留分叉并生成合并提交；rebase 把提交重放到新基底上，历史变成线性",
      "explain": "已经推送、别人也在用的分支，不要 rebase 后强推。",
      "tags": [
        "效率工具"
      ],
      "options": [
        "merge 保留分叉并生成合并提交；rebase 把提交重放到新基底上，历史变成线性",
        "两者完全相同",
        "rebase 会删除代码",
        "merge 只能用于主分支"
      ],
      "accept": [],
      "grading": "auto"
    },
    {
      "id": "tool-0006",
      "point_id": "tools.git.basics",
      "level": 1,
      "type": "choice",
      "prompt": "合并时出现冲突，正确的处理顺序？",
      "answer": "打开冲突文件手动改好 → git add → 继续 merge/rebase",
      "explain": "冲突标记 <<<<<<< ======= >>>>>>> 必须全部清理掉。",
      "tags": [
        "效率工具"
      ],
      "options": [
        "打开冲突文件手动改好 → git add → 继续 merge/rebase",
        "直接 git push -f",
        "删掉整个仓库重新 clone",
        "忽略冲突标记直接提交"
      ],
      "accept": [],
      "grading": "auto"
    },
    {
