      "point_id": "tools.git.secrets",
      "level": 1,
      "type": "code",
      "prompt": "停止跟踪已提交的 .env，但保留本地文件。",
      "answer": "git rm --cached .env",
      "explain": "之后把 .env 加进 .gitignore 再提交。",
      "tags": [
        "效率工具"
      ],
      "accept": [
        "git rm --cached -- .env"
