      "point_id": "tools.git.secrets",
      "level": 1,
      "type": "concept",
      "prompt": "防止 .env 被 Git 跟踪，要把它写进哪个文件？",
      "answer": "gitignore",
      "explain": ".gitignore 只对还没被跟踪的文件生效；已经跟踪的，要先 git rm --cached。",
      "tags": [
        "效率工具"
      ],
      "accept": [
        ".gitignore",
        "gitignore 文件"
      ],
      "grading": "auto"
