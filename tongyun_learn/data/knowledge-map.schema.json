{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongyun.local/learn/knowledge-map.schema.json",
  "title": "tongyun-learn 知识地图（一学科一文件）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_version", "subject", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "map_version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$", "description": "地图版本，YYYY-MM-DD.N；导入时记录"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prefix", "title", "goal"],
      "properties": {
        "id": {"$ref": "#/$defs/slug", "description": "学科 slug，如 java-fde"},
        "prefix": {"type": "string", "pattern": "^[a-z][a-z0-9]*$", "description": "本学科所有阶段/知识点 id 的前缀，如 jf"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "axue_area": {"enum": ["开发编程", "Web", "AI", "技术英语"], "description": "对应旧 axue_learning 的领域，迁移用"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "nodeId": {"type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9]+(-[a-z0-9]+)*$", "description": "<subject.prefix>.<slug>，全局唯一、永不复用"},
    "cardType": {"enum": ["记忆卡", "理解卡", "动手卡", "表达卡"]},
    "evidenceType": {"enum": ["自测", "费曼", "表达", "动手"]},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "goal", "points"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "weeks": {"type": "string", "description": "对应 12 周路径的周次，如 1-2；英语可写 贯穿"},
        "goal": {"type": "string"},
        "deliverable": {"type": "string", "description": "阶段产物"},
        "exit_criteria": {"type": "string", "description": "阶段过关标准（不等于全部掌握）"},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "card_types", "prerequisites", "effort_hours", "interview_weight", "mastery_evidence", "example_cards"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "card_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/cardType"}},
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": {"$ref": "#/$defs/nodeId"},
              "kind": {"enum": ["hard", "soft"], "description": "hard=学过才解锁；soft=只做推荐排序和提示"}
            }
          }
        },
        "effort_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 20, "description": "首次学一遍的预计小时数"},
        "interview_weight": {"type": "integer", "minimum": 0, "maximum": 3, "description": "0=面试不考，1=偶尔，2=常考，3=必考"},
        "mastery_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceType"}, "description": "判定掌握时必须由阿学记录达标的证据类型；空=只看 FSRS"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "ref"],
            "properties": {
              "type": {"enum": ["lesson", "doc", "url", "path"], "description": "lesson=axue 课程 code；doc/url=官方文档；path=box 上文件"},
              "ref": {"type": "string", "minLength": 1},
              "title": {"type": "string"}
            }
          }
        },
        "example_cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "front", "back"],
            "properties": {
              "type": {"$ref": "#/$defs/cardType"},
              "front": {"type": "string", "minLength": 1},
              "back": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
